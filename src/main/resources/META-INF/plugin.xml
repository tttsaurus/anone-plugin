<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.cleanroommc.anoneplugin</id>
    <name>AnoNe</name>
    <vendor>tttsaurus</vendor>
    <description><![CDATA[
        <p><b>anone-plugin</b> is a repository that provides IDEA integration for AnoNe.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <resource-bundle>messages.AnoNeBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">

        <implicitUsageProvider
                implementation="com.cleanroommc.anoneplugin.reveal.RevealImplicitUsageProvider"/>

        <lang.inspectionSuppressor
                language="JAVA"
                implementationClass="com.cleanroommc.anoneplugin.value.CanIgnoreReturnValueInspectionSuppressor"/>

        <localInspection
                language="JAVA"
                shortName="AnoNeInvokeOnly"
                groupKey="inspection.anone.group.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.cleanroommc.anoneplugin.canon.InvokeOnlyInspection"
                key="inspection.anone.invokeOnly.display.name"/>

        <localInspection
                language="JAVA"
                shortName="AnoNeOverrideOnly"
                groupKey="inspection.anone.group.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.cleanroommc.anoneplugin.canon.OverrideOnlyInspection"
                key="inspection.anone.overrideOnly.display.name"/>

        <localInspection
                language="JAVA"
                shortName="AnoNeOverrideOnlyBypass"
                groupKey="inspection.anone.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.cleanroommc.anoneplugin.canon.SusOverrideOnlyBypassInspection"
                key="inspection.anone.overrideOnlyBypass.display.name"/>

        <localInspection
                language="JAVA"
                shortName="AnoNeMustNotClose"
                groupKey="inspection.anone.group.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.cleanroommc.anoneplugin.lifecycle.MustNotCloseInspection"
                key="inspection.anone.mustNotClose.display.name"/>

        <localInspection
                language="JAVA"
                shortName="AnoNeMustCallAt"
                groupKey="inspection.anone.group.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.cleanroommc.anoneplugin.canon.MustCallAtInspection"
                key="inspection.anone.mustCallAt.display.name"/>

        <localInspection
                language="JAVA"
                shortName="AnoNeMustNotCallAt"
                groupKey="inspection.anone.group.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.cleanroommc.anoneplugin.canon.MustNotCallAtInspection"
                key="inspection.anone.mustNotCallAt.display.name"/>

    </extensions>
</idea-plugin>
